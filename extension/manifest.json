{
  "manifest_version": 3,
  "name": "WordStart Reader",
  "version": "1.5.2",
  "description": "Toggle adjustable partial-word bold text. Free, local, and independent.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/off-16.png", "48": "icons/off-48.png", "128": "icons/off-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "WordStart Reader", "default_icon": { "16": "icons/off-16.png", "32": "icons/off-32.png" } }
}
